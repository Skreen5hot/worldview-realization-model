 "reference_conditions": [
  {
   "description": "Where a specification prescribes a quality borne by an artifact and a measurement of that quality exists, the measured value must lie within the specification's prescribed bounds.",
   "domain": "artifact_specification_conformance",
   "id": "RC-01",
   "label": "Specification conformance of a measured quality",
   "objectives": [
    {
     "objective": "OBJ-01",
     "rationale": "A measured value outside the prescribed bounds is a direct non-conformity of the artifact to its specification."
    }
   ],
   "prescribed": {
    "constraints": [
     [
      "?m.value",
      "within",
      "?spec.lower",
      "?spec.upper"
     ]
    ],
    "kind": "value_constraint"
   },
   "remediation": {
    "value_fact_steps": [
     {
      "action_type": "rework_or_segregate",
      "actor": "responder",
      "effect": "bring the artifact's quality back within the prescribed bounds or segregate it",
      "operation": "create",
      "relation": "has_participant",
      "source": "NEW:Act of Artifact Modification:rework",
      "target": "?lot"
     }
    ]
   },
   "satisfaction_condition": "Every measurement of the prescribed quality lies within the specification bounds, or the artifact is segregated by a rework act."
  },
  {
   "description": "Where a nonconformance report is about a lot, a corrective-action act taking that report as input must exist.",
   "domain": "quality_process_monitoring",
   "id": "RC-03",
   "label": "Corrective action on a nonconformance report",
   "objectives": [
    {
     "objective": "OBJ-03",
     "rationale": "Quality-system obligations require every nonconformance report to be closed by a corrective action."
    }
   ],
   "prescribed": {
    "edges": [
     [
      "?ca",
      "has_input",
      "?ncr"
     ]
    ],
    "kind": "exists",
    "nodes": {
     "?ca": {
      "attributes": {
       "kind": "corrective_action"
      },
      "type": "Planned Act"
     }
    }
   },
   "remediation": {},
   "satisfaction_condition": "A corrective-action act has the nonconformance report as input."
  },
  {
   "description": "Where a nonconformance report and a directive are both about the same lot and the directive is the output of a decision act, that decision act must have the report as input.",
   "domain": "artifact_specification_conformance",
   "id": "RC-04",
   "label": "Nonconforming product control in directives",
   "objectives": [
    {
     "objective": "OBJ-03",
     "rationale": "Disposition of nonconforming product must be decided with the nonconformance record before it."
    },
    {
     "objective": "OBJ-05",
     "rationale": "A directive about a lot issued without its nonconformance record is a decision made on incomplete information."
    }
   ],
   "prescribed": {
    "edges": [
     [
      "?dec",
      "has_input",
      "?ncr"
     ]
    ],
    "kind": "exists",
    "nodes": {}
   },
   "remediation": {},
   "satisfaction_condition": "The decision act that produced the directive has the nonconformance report as input."
  },
  {
   "description": "Where a communication delivers a conformance-asserting certificate about a lot to a recipient and a nonconformance report about the same lot exists, a communication delivering that report to the same recipient must exist.",
   "domain": "reporting_communication",
   "id": "RC-06",
   "label": "Completeness of conformance communication",
   "objectives": [
    {
     "objective": "OBJ-04",
     "rationale": "A recipient who holds only the conformance assertion cannot exercise informed judgment about the lot."
    }
   ],
   "prescribed": {
    "edges": [
     [
      "?c2",
      "has_input",
      "?ncr"
     ],
     [
      "?c2",
      "has_recipient",
      "?party"
     ]
    ],
    "kind": "exists",
    "nodes": {
     "?c2": {
      "type": "Act of Communication"
     }
    }
   },
   "remediation": {},
   "satisfaction_condition": "The recipient of the certificate has also received the nonconformance report."
  },
  {
   "description": "Where a regulation prescribes a quality-management process and a safety-relevant nonconformance report exists, a communication delivering that report to a government organization must exist.",
   "domain": "organizational_accountability",
   "id": "RC-10",
   "label": "Regulatory notification of a safety-relevant nonconformance",
   "objectives": [
    {
     "objective": "OBJ-03",
     "rationale": "The regulation makes notification of safety-relevant nonconformance an institutional obligation."
    }
   ],
   "prescribed": {
    "edges": [
     [
      "?c",
      "has_input",
      "?ncr"
     ],
     [
      "?c",
      "has_recipient",
      "?gov"
     ]
    ],
    "kind": "exists",
    "nodes": {
     "?c": {},
     "?gov": {
      "type": "Government Organization"
     }
    }
   },
   "remediation": {},
   "satisfaction_condition": "A government organization has received a communication carrying the nonconformance report."
  },
  {
   "description": "Where a communication carrying a nonconformance report precedes a decision act, the decision act must have that report as input.",
   "domain": "organizational_accountability",
   "id": "RC-11",
   "label": "Decision informed by a preceding report communication",
   "objectives": [
    {
     "objective": "OBJ-05",
     "rationale": "A decision that follows a report but does not take it as input is made on unreliable information."
    }
   ],
   "prescribed": {
    "edges": [
